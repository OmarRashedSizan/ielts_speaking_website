# ---------------------------------------------------------------------------
# Optional: AI speaking evaluation provider.
# The learner-facing AI feedback panel works WITHOUT any key by using the
# built-in rule-based rubric engine. Set a key only if you want LLM feedback.
# Never commit real keys.
# ---------------------------------------------------------------------------
AI_PROVIDER=            # openai | anthropic | "" (rule-based fallback)
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# Rate limiting for /api/evaluate (requests per minute per IP)
EVALUATE_RATE_LIMIT=12
